# Universal final USB image for a tested new lock. eFuses are programmed on first boot.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_factory_usb.csv"
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
# CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC is not set
