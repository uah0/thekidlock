<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_button" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="0dp"
    android:clipChildren="true" android:clipToPadding="true">
    <FrameLayout
        android:layout_width="@dimen/widget_icon_size"
        android:layout_height="@dimen/widget_icon_size">
        <ImageView android:id="@+id/widget_icon"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/ic_launcher" android:contentDescription="@null" />
        <ImageView android:layout_width="12dp" android:layout_height="12dp"
            android:layout_gravity="bottom|left"
            android:src="@drawable/ic_widget_shortcut_badge" android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
